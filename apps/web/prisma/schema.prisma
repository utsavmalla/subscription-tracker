generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RenewalCycle {
  Monthly
  Quarterly
  Yearly
  OneTime
}

enum SubscriptionStatus {
  Active
  Upcoming
  DueToday
  Overdue
  Expired
  Completed
}

enum AlertState {
  None
  Upcoming
  DueToday
  Overdue
  Expired
}

enum ReminderType {
  Upcoming
  DueToday
  Overdue
}

enum ReminderEventStatus {
  Pending
  Sent
  Failed
  Dismissed
}

model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  serviceName     String             @map("service_name") @db.VarChar(160)
  usdAmount       Decimal?           @map("usd_amount") @db.Decimal(10, 2)
  localAmount     Decimal?           @map("local_amount") @db.Decimal(12, 2)
  currencyCode    String?            @map("currency_code") @db.VarChar(3)
  datePaid        DateTime?          @map("date_paid") @db.Date
  renewalCycle    RenewalCycle       @map("renewal_cycle")
  nextRenewalDate DateTime?          @map("next_renewal_date") @db.Date
  expirationDate  DateTime?          @map("expiration_date") @db.Date
  status          SubscriptionStatus @default(Active)
  alertState      AlertState         @default(None) @map("alert_state")
  done            Boolean            @default(false)
  remarks         String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reminderEvents  ReminderEvent[]

  @@unique([id, userId], map: "subscriptions_id_user_id_key")
  @@index([userId], map: "subscriptions_user_id_idx")
  @@index([userId, status], map: "subscriptions_user_status_idx")
  @@index([userId, alertState], map: "subscriptions_user_alert_state_idx")
  @@index([userId, nextRenewalDate], map: "subscriptions_user_next_renewal_idx")
  @@index([userId, expirationDate], map: "subscriptions_user_expiration_idx")
  @@map("subscriptions")
}

model ReminderEvent {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  reminderType   ReminderType        @map("reminder_type")
  scheduledFor   DateTime            @map("scheduled_for") @db.Timestamptz(6)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  status         ReminderEventStatus @default(Pending)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  subscription   Subscription        @relation(fields: [subscriptionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, subscriptionId, reminderType, scheduledFor], map: "reminder_events_unique_daily_subscription_type")
  @@index([userId], map: "reminder_events_user_id_idx")
  @@index([subscriptionId], map: "reminder_events_subscription_id_idx")
  @@index([subscriptionId, userId], map: "reminder_events_subscription_owner_idx")
  @@index([userId, status, scheduledFor], map: "reminder_events_user_status_scheduled_idx")
  @@map("reminder_events")
}
