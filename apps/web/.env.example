NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PROJECT_KEY
# Legacy anon keys also work if your Supabase project has not moved to publishable keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Shared secret used by the scheduled reminder refresh job.
REMINDER_REFRESH_SECRET=change-me-to-a-long-random-secret

# Runtime database URL. Use Supabase's transaction pooler for app traffic.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct database URL. Use Supabase's session pooler or direct connection for Prisma migrations/admin commands.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
